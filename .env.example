# ====================================================
# Required environment variables for Kindred backend.
# In production, set these in your platform dashboard
# (Render Variables tab, Railway Variables, etc.).
# ====================================================

PORT=4000

# Postgres connection string
# Local Postgres example:  postgresql://postgres:password@localhost:5432/kindred
# Render Postgres example: postgresql://user:pass@dpg-xxxxx-a.oregon-postgres.render.com/dbname
DATABASE_URL=

# Admin login credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password

# JWT signing secret — must be a long random string (40+ chars)
JWT_SECRET=generate_a_long_random_string_here

# Allowed frontend origin(s) for CORS — comma-separated for multiple
# Production example: https://yourdomain.com,https://www.yourdomain.com
FRONTEND_ORIGIN=http://localhost:5173

# Max receipt/image upload size in MB
MAX_UPLOAD_MB=5

# (Production only) Path to persistent disk for uploads
# UPLOAD_DIR=/data/uploads

# (Optional) Set to "disable" to turn off SSL — only for local Postgres
# PGSSL=disable
